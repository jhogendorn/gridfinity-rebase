{
  "name": "gridfinity-rebase",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "bin": {
    "gridfinity-rebase": "./dist-cli/cli.mjs"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:cli": "esbuild cli.ts --bundle --platform=node --format=esm --outfile=dist-cli/cli.mjs && cp src/openscad.wasm dist-cli/ && chmod +x dist-cli/cli.mjs",
    "prepare": "npm run build:cli",
    "lint": "eslint .",
    "pretest": "npm run build:cli",
    "test": "rm -rf dist-test && { [ -f test/step-utils.test.ts ] && esbuild test/step-utils.test.ts --bundle --platform=node --format=esm --outfile=dist-test/step-utils.test.mjs || [ ! -f test/step-utils.test.ts ]; } && node --test 'test/**/*.test.mjs' 'dist-test/**/*.test.mjs'",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.3.1",
    "@types/three": "^0.167.1",
    "@types/uuid": "^10.0.0",
    "hull.js": "andriiheonia/hull",
    "idb": "^8.0.1",
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.167.1",
    "union-find": "^1.0.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
